<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    <PublishTrimmed>false</PublishTrimmed>
    <DebugType>embedded</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <CompactPortable>true</CompactPortable>
    <OutputPath>artifacts\compact-build\</OutputPath>
    <PublishDir>artifacts\compact-portable\Wardog-DMA\</PublishDir>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="Native\Dma\*" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Always" />
  </ItemGroup>
  <Target Name="CompactUsePinnedFtdi" BeforeTargets="_HandleFileConflictsForPublish">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
        Condition="'%(ResolvedFileToPublish.Filename)%(ResolvedFileToPublish.Extension)' == 'FTD3XX.dll' and '%(ResolvedFileToPublish.FullPath)' != '$(MSBuildProjectDirectory)\Native\Dma\FTD3XX.dll'" />
    </ItemGroup>
  </Target>
</Project>
